# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL runtime connection variables (injected automatically in AI Studio)
SQL_HOST="localhost"
SQL_DB_NAME="artverse"
SQL_USER="artverse_app_user"
SQL_PASSWORD="YOUR_SQL_PASSWORD_PLACEHOLDER"
SQL_ADMIN_USER="artverse_admin_user"
SQL_ADMIN_PASSWORD="YOUR_SQL_ADMIN_PASSWORD_PLACEHOLDER"

# Optional Supabase client configuration (used by src/lib/supabase.ts when deploying with Supabase)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key-placeholder"
